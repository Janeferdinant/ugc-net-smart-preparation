{
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/health", "dest": "/api/health.json" },
    { "src": "/api/subjects", "dest": "/api/subjects.json" },
    { "src": "/api/analytics/overview", "dest": "/api/analytics/overview.json" },
    { "src": "/api/papers", "dest": "/api/papers.json" },
    { "src": "/api/questions", "dest": "/api/questions.json" },
    { "src": "/api/mock-tests", "dest": "/api/mock-tests.json" },
    { "src": "/api/verification-report", "dest": "/api/verification-report.json" },
    { "src": "/api/study-plan/30-days", "dest": "/api/study-plan/30-days.json" },
    { "src": "/api/career", "dest": "/api/career.json" },
    { "src": "/api/syllabus/([^/]+)", "dest": "/api/syllabus/$1.json" },
    { "src": "/api/mock-tests/([^/]+)", "dest": "/api/mock-tests/$1.json" },
    { "src": "/api/knowledge-graph/([^/]+)", "dest": "/api/knowledge-graph/$1.json" },
    { "src": "/api/papers/([^/]+)", "dest": "/api/papers/$1.json" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
